def gemm_kernel(a: tensor<3xkxi32>, b: tensor<kx5xi32>, c: tensor<3x5xi32>, k: int) {
  c = dot(a, b);
}

def main() {
  var k : int = 3;
  var a : tensor<3xkxi32>;
  var b : tensor<kx5xi32>;
  var c : tensor<3x5xi32>;

  random(a);
  random(b);
  gemm_kernel(a, b, c, k);

  print(a);
  print(b);
  print(c);
}
