def add_two_vectors(a: tensor<d0x8xf32>, b: tensor<d0x8xf32>, out: tensor<d0x8xf32>, d0: int) {
  out = add(a, b);
}

def main() {
  var d0 : int = 4;
  var a : tensor<d0x8xf32>;
  var b : tensor<d0x8xf32>;
  var out : tensor<d0x8xf32>;

  random(a);
  random(b);
  add_two_vectors(a, b, out, d0);

  print(a);
  print(b);
  print(out);
}
