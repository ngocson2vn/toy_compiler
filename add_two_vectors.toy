def add_two_vectors(a: tensor<d0xd1xi32>, b: tensor<d0xd1xi32>, out: tensor<d0xd1xi32>, d0: int, d1: int) {
  out = add(a, b);
}

def main() {
  var d0 : int = 16;
  var d1 : int = 32;
  var t1 : tensor<d0xd1xi32>;
  var t2 : tensor<d0xd1xi32>;
  var t3 : tensor<d0xd1xi32>;

  random(t1);
  random(t2);
  add_two_vectors(t1, t2, t3, d0, d1);

  print(t1);
  print(t2);
  print(t3);
}
