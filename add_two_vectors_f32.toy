def add_two_vectors(a: tensor<d0xd1xf32>, b: tensor<d0xd1xf32>, out: tensor<d0xd1xf32>, d0: int, d1: int) {
  out = add(a, b);
}

def main() {
  var d0 : int = 4;
  var d1 : int = 8;
  var a : tensor<d0xd1xf32>;
  var b : tensor<d0xd1xf32>;
  var out : tensor<d0xd1xf32>;

  random(a);
  random(b);
  add_two_vectors(a, b, out, d0, d1);

  print(a);
  print(b);
  print(out);
}
