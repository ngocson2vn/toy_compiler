def add_max_vectors(a: tensor<128xd1xf32>, b: tensor<128xd1xf32>, out: tensor<128xd1xf32>, d1: int) {
  var tmp0 = add(a, b);
  out = max(tmp0, 0);
}

def main() {
  var d1 : int = 256;
  var a : tensor<128xd1xf32>;
  var b : tensor<128xd1xf32>;
  var out : tensor<128xd1xf32>;

  random(a);
  random(b);
  add_max_vectors(a, b, out, d1);
  print(out);
}
