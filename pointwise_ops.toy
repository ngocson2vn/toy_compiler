def gpu_compute(a: tensor<d0xd1xf32>, b: tensor<d0xd1xf32>, c: tensor<d0xd1xf32>, d0: int, d1: int) {
  var tmp0 = add(a, b);
  var tmp1 = mul(tmp0, a);
  c = max(tmp1, 0);
}

#
# NOTE: THERE IS A BUG WITH 2D TENSORS
#
def main() {
  var d0 : int = 32;
  var d1 : int = 64;
  var a : tensor<d0xd1xf32>;
  var b : tensor<d0xd1xf32>;
  var c : tensor<d0xd1xf32>;

  random(a);
  random(b);
  gpu_compute(a, b, c, d0, d1);

  # print(a);
  # print(b);
  print(c);
}
